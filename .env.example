# ============================================================
# Governed Multi-Agent Business Team — environment configuration
# Copy this file to `.env` (in backend/) and adjust as needed.
# NEVER commit a real .env with secrets.
# ============================================================

# ---- LLM provider configuration ----
# Provider options: hy3 | mock | anthropic
#   hy3      -> OpenAI-compatible Chat Completions endpoint
#   mock     -> deterministic, keyless provider (best for reliable demos)
#   anthropic-> Anthropic Messages API
# If LLM_PROVIDER requires a key and LLM_API_KEY is empty, the system
# automatically falls back to `mock` and logs a warning (demo never fails).
LLM_PROVIDER=hy3

# OpenAI-compatible endpoint used for HY3 (and OpenAI itself)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Anthropic settings (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Reliability knobs
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Estimated pricing used ONLY for cost metrics (USD per 1K tokens).
# These are APPROXIMATIONS for demo metrics, not real billing.
LLM_PRICE_PER_1K_INPUT=0.00015
LLM_PRICE_PER_1K_OUTPUT=0.0006

# ---- Governance ----
# Maximum permitted estimated spend (USD) before an action is BLOCKED.
SPEND_LIMIT_USD=5.00

# Comma-separated actions that REQUIRE human approval.
APPROVAL_REQUIRED_ACTIONS=send_email,schedule_meeting

# ---- Failure injection (demo) ----
# Tool that should fail on its first N calls, then recover.
# Set FAILURE_INJECT_TOOL=none to disable automatic injection.
FAILURE_INJECT_TOOL=get_company_profile
FAILURE_INJECT_COUNT=1

# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
